# --- Core ---
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Google Sign-In (screen 02 LOGIN) ---
# Web client ID from Google Cloud Console > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""

# --- News (personalised feed) ---
# https://gnews.io/register  - free tier, 100 req/day
GNEWS_API_KEY=""

# --- Text to speech (Aria / Kai / Meera voices) ---
# https://elevenlabs.io > Profile > API Keys - free tier, 10k chars/month
ELEVENLABS_API_KEY=""

# When keys are absent the server falls back to seeded stories and
# on-device speech, so the app always runs.
